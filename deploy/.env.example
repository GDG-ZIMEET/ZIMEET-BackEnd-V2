# =========================================================================
# ZIMEET 로컬 스택 환경변수 템플릿
# -------------------------------------------------------------------------
# 사용:
#   cp deploy/.env.example deploy/.env
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d
# =========================================================================

# ---------- Business DB (core 서버 전용) ----------
BUSINESS_DB_NAME=zimeet_business
BUSINESS_DB_USERNAME=root
BUSINESS_DB_PASSWORD=root

# ---------- Payment DB (payment 서버 전용) ----------
PAYMENT_DB_NAME=zimeet_payment
PAYMENT_DB_USERNAME=root
PAYMENT_DB_PASSWORD=root

# ---------- MongoDB (chat) ----------
MONGODB_DATABASE=zimeet

# ---------- App secrets ----------
JWT_SECRET_KEY=changeme_local_only_thisshouldbelongenough
FIREBASE_ADMIN_SDK_PATH=/app/firebase-adminsdk.json

# ---------- Monitoring (overlay) ----------
GRAFANA_USER=admin
GRAFANA_PW=admin
